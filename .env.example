# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ
# คำสั่ง: cp .env.example .env

PORT=3000

# รหัสผ่านสำหรับเข้าหน้าแอดมิน (เปลี่ยนเป็นรหัสที่คาดเดายากก่อนใช้งานจริง)
ADMIN_PASSWORD=changeme123

# กุญแจลับสำหรับเข้ารหัส session ของแอดมิน (ตั้งเป็นข้อความสุ่มยาวๆ)
SESSION_SECRET=please-change-this-to-a-long-random-string
